#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
export PULSE_SERVER=${PULSE_SERVER:-unix:$XDG_RUNTIME_DIR/pulse/native}
config=${XDG_CONFIG_HOME:-$HOME/.config}/retroarch
data=${XDG_DATA_HOME:-$HOME/.local/share}/retroarch
mkdir -p "$config" "$data/cores" "$data/info" "$data/autoconfig" "$data/playlists"
if [ ! -e "$config/retroarch.cfg" ]; then
 cp /usr/local/share/redmi-nas/retroarch/retroarch.cfg "$config/retroarch.cfg"
fi
for source in /usr/lib/aarch64-linux-gnu/libretro/*_libretro.so /usr/local/share/redmi-nas/retroarch/cores/*_libretro.so; do
 test -f "$source" || continue
 target="$data/cores/$(basename "$source")"
 test -e "$target" || cp "$source" "$target"
done
cp -n /usr/share/libretro/info/*.info "$data/info/" 2>/dev/null || true
if [ -d /usr/share/libretro/autoconfig ]; then
 cp -an /usr/share/libretro/autoconfig/. "$data/autoconfig/" 2>/dev/null || true
fi
if [ -d /usr/local/share/redmi-nas/retroarch/autoconfig ]; then
 cp -an /usr/local/share/redmi-nas/retroarch/autoconfig/. "$data/autoconfig/" 2>/dev/null || true
fi
systemctl --user start pulseaudio.socket audiosystem-passthrough.service
exec /usr/bin/retroarch --config "$config/retroarch.cfg" "$@"

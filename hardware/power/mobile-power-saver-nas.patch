 static void
+profile_changed (Bus *self, PowerProfile profile)
+{
+    GVariantBuilder changed;
+    self->priv->power_profile = profile;
+    if (g_strcmp0 (g_getenv ("REDMI_NAS_MODE"), "1") == 0) {
+        g_mkdir_with_parents ("/var/lib/redmi-nas", 0755);
+        g_file_set_contents ("/var/lib/redmi-nas/energy-profile",
+                             get_power_profile_as_string (profile), -1, NULL);
+    }
+    g_signal_emit (self, signals[BUS_SETTING_CHANGED], 0,
+                   g_variant_new ("(sv)", "power-saving-mode",
+                                  g_variant_new_int32 (profile)));
+    if (self->priv->upowerpp_connection != NULL) {
+        g_variant_builder_init (&changed, G_VARIANT_TYPE ("a{sv}"));
+        g_variant_builder_add (&changed, "{sv}", "ActiveProfile",
+                                g_variant_new_string (get_power_profile_as_string (profile)));
+        g_dbus_connection_emit_signal (self->priv->upowerpp_connection,
+            NULL, UPOWERPP_DBUS_PATH, DBUS_PROPERTIES_INTERFACE,
+            "PropertiesChanged",
+            g_variant_new ("(s@a{sv}@as)", UPOWERPP_DBUS_NAME,
+                g_variant_builder_end (&changed), g_variant_new_strv (NULL, 0)), NULL);
+    }

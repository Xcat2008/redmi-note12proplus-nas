-function readStorageDetailsCache() {
-  if (!storageDetailsCache) return null;
-  if (storageDetailsCache.expiresAt <= Date.now()) {
-    storageDetailsCache = null;
-    return null;
-  }
-  return storageDetailsCache.value;

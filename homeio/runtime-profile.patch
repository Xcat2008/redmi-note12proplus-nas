-function readHelperStatusCache() {
-  if (!helperStatusCache) return null;
-  if (helperStatusCache.expiresAt <= Date.now()) {
-    helperStatusCache = null;
-    return null;
-  }
-
-  return helperStatusCache.value;
-}
